---
interface Props {
  name: 'whatsapp' | 'email' | 'instagram';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'whatsapp' && (
      <>
        <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" />
        <path
          d="M8.8 8.2c.3-.6.9-.6 1.2-.1l.8 1.5c.2.4 0 .8-.3 1.1l-.4.4c.6 1.3 1.6 2.3 2.9 2.9l.4-.4c.3-.3.7-.5 1.1-.3l1.5.8c.5.3.5.9-.1 1.2-.8.5-1.8.7-2.8.3-2.3-.9-4-2.6-4.9-4.9-.3-1-.1-1.9.6-2.5z"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }
  {
    name === 'email' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
        <path d="M3.5 7 12 13l8.5-6" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>
